{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:deploycraft:package:1",
  "title":"DeployCraft package manifest v1",
  "type":"object","additionalProperties":false,
  "required":["schema","id","name","version","platform","payload","install","detect"],
  "properties":{
    "schema":{"const":1},
    "id":{"$ref":"#/$defs/id"},
    "name":{"type":"string","minLength":1},
    "version":{"$ref":"#/$defs/version"},
    "publisher":{"type":"string"},
    "platform":{"type":"object","additionalProperties":false,"required":["os","arch"],
      "properties":{"os":{"const":"windows"},"arch":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["x64","x86","arm64"]}},"minBuild":{"type":"integer","minimum":0}}},
    "payload":{"type":"object","additionalProperties":false,"required":["kind","path"],
      "properties":{
        "kind":{"enum":["file","dir","archive"]},
        "path":{"$ref":"#/$defs/relPath"},
        "sha256":{"$ref":"#/$defs/hash"},
        "size":{"type":"integer","minimum":1},
        "entry":{"$ref":"#/$defs/relPath"},
        "files":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/file"}}
      },
      "if":{"properties":{"kind":{"const":"dir"}},"required":["kind"]},
      "then":{"required":["entry","files"],"properties":{"sha256":false,"size":false}},
      "else":{"required":["sha256","size"],"properties":{"entry":false,"files":false}}
    },
    "install":{"type":"object","additionalProperties":false,"required":["driver","timeoutSec","successCodes"],
      "properties":{
        "driver":{"enum":["msi","exe","portable","script","msix"]},
        "args":{"type":"array","items":{"$ref":"#/$defs/arg"}},
        "rawCmdLine":{"type":"string","minLength":1},
        "dir":{"type":"string","minLength":1},
        "timeoutSec":{"type":"integer","minimum":1},
        "successCodes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer"}},
        "rebootCodes":{"type":"array","uniqueItems":true,"items":{"type":"integer"}},
        "retryCodes":{"type":"array","uniqueItems":true,"items":{"type":"integer"}},
        "rebootBarrier":{"type":"boolean"},
        "target":{"type":"string","minLength":1},
        "addToPath":{"type":"boolean"},
        "shortcuts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","target"],"properties":{
          "name":{"type":"string","minLength":1},"target":{"$ref":"#/$defs/relPath"},"location":{"enum":["startMenu","desktop"]}}}},
        "uninstallEntry":{"type":"object","additionalProperties":false,"required":["displayName"],"properties":{"displayName":{"type":"string","minLength":1}}}
      },
      "allOf":[
        {"not":{"required":["args","rawCmdLine"]}},
        {"if":{"properties":{"driver":{"const":"portable"}},"required":["driver"]},
         "then":{"required":["target"],"properties":{"args":false,"rawCmdLine":false}},
         "else":{"properties":{"target":false,"addToPath":false,"shortcuts":false,"uninstallEntry":false}}}
      ]
    },
    "detect":{"type":"object","additionalProperties":false,"required":["match","rules"],
      "properties":{"match":{"enum":["any","all"]},"rules":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/rule"}}}},
    "uninstall":{"type":"object","additionalProperties":false,"required":["driver"],
      "properties":{"driver":{"enum":["msi","exe","portable","script"]},"command":{"type":"string","minLength":1},"args":{"type":"array","items":{"$ref":"#/$defs/arg"}}}},
    "dependsOn":{"$ref":"#/$defs/ids"},
    "conflictsWith":{"$ref":"#/$defs/ids"},
    "provenance":{"type":"object","additionalProperties":false,"properties":{
      "source":{"type":"string"},"vendorHash":{"type":"string"},"addedOn":{"type":"string","format":"date"}}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},
    "ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "version":{"type":"string","pattern":"^[0-9]+(\\.[0-9]+)*$"},
    "hash":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
    "relPath":{"type":"string","minLength":1,"allOf":[
      {"not":{"pattern":"^([A-Za-z]:|[/\\\\])"}},
      {"not":{"pattern":"(^|[/\\\\])\\.\\.([/\\\\]|$)"}}
    ]},
    "file":{"type":"object","additionalProperties":false,"required":["path","sha256","size"],"properties":{
      "path":{"$ref":"#/$defs/relPath"},"sha256":{"$ref":"#/$defs/hash"},"size":{"type":"integer","minimum":1}}},
    "arg":{"if":{"type":"object"},
      "then":{"type":"object","additionalProperties":false,"required":["value","secret"],"properties":{
        "value":{"type":"string","pattern":"\\{secret\\}"},"secret":{"$ref":"#/$defs/id"}}},
      "else":{"type":"string","not":{"pattern":"\\{secret\\}"}}},
    "rule":{"type":"object","required":["type"],"properties":{"type":{"enum":["registry-uninstall","msi-product-code","file","registry-value","command","appx"]}},"allOf":[
      {"if":{"properties":{"type":{"const":"registry-uninstall"}},"required":["type"]},"then":{
        "additionalProperties":false,"required":["displayName"],"properties":{
          "type":true,"displayName":{"type":"string","minLength":1},"minVersion":{"$ref":"#/$defs/version"}}}},
      {"if":{"properties":{"type":{"const":"msi-product-code"}},"required":["type"]},"then":{
        "additionalProperties":false,"required":["productCode"],"properties":{
          "type":true,"productCode":{"type":"string","pattern":"^\\{[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}\\}$"}}}},
      {"if":{"properties":{"type":{"const":"file"}},"required":["type"]},"then":{
        "additionalProperties":false,"required":["path"],"properties":{
          "type":true,"path":{"type":"string","minLength":1},"minVersion":{"$ref":"#/$defs/version"}}}},
      {"if":{"properties":{"type":{"const":"registry-value"}},"required":["type"]},"then":{
        "additionalProperties":false,"required":["key","value"],"properties":{
          "type":true,"key":{"type":"string","pattern":"^(HKLM|HKCU)\\\\"},"value":{"type":"string","minLength":1},
          "equals":{},"atLeast":{"type":"integer"},"minVersion":{"$ref":"#/$defs/version"}}}},
      {"if":{"properties":{"type":{"const":"command"}},"required":["type"]},"then":{
        "additionalProperties":false,"required":["command","matches"],"properties":{
          "type":true,"command":{"type":"string","minLength":1},"args":{"type":"array","items":{"type":"string"}},
          "matches":{"type":"string","minLength":1},"timeoutSec":{"type":"integer","minimum":1,"maximum":120}}}},
      {"if":{"properties":{"type":{"const":"appx"}},"required":["type"]},"then":{
        "additionalProperties":false,"required":["name"],"properties":{
          "type":true,"name":{"type":"string","minLength":1},"minVersion":{"$ref":"#/$defs/version"}}}}
    ]}
  }
}

