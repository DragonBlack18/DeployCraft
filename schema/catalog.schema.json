{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deploycraft:catalog:1",
  "title": "DeployCraft catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","catalogVersion","packages","profiles"],
  "properties": {
    "schema": {"const":1},
    "catalogVersion": {"type":"string","pattern":"^[0-9]+(\\.[0-9]+)*$"},
    "packages": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^packages/[a-z0-9]+(-[a-z0-9]+)*\\.json$"}},
    "profiles": {"type":"array","items":{
      "type":"object","additionalProperties":false,"required":["id","name","packages"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "name":{"type":"string","minLength":1},
        "extends":{"$ref":"#/$defs/id"},
        "packages":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "atomic":{"type":"boolean"}
      }
    }}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"}}
}

